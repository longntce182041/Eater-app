# Server
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/ai_healthy_meal_planner

# JWT Auth
JWT_SECRET=your_jwt_access_secret_here
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# CORS - Allowed origins for requests from different clients
# Supports:
# - React Frontend: http://localhost:5173
# - Flutter Web: http://localhost:* (any port for Flutter dev server)
# - Mobile emulators: http://10.0.2.2:* (Android) or http://localhost:* (iOS)
CORS_ORIGIN=*
ALLOWED_ORIGINS=*

# SMTP (for password reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tranphantrungkien2004@gmail.com
SMTP_PASS=mvqjlbswaaqjecnb
SMTP_FROM="Eater App <tranphantrungkien2004@gmail.com>"
# AI Service (FastAPI) Integration
AI_SERVICE_URL=http://localhost:8000

# Logging
LOG_LEVEL=info

# Optional: Admin initial account
ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=ChangeThisPassword123