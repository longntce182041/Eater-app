# Application Settings
PROJECT_NAME=AI Meal Planning Service
VERSION=1.0.0
DEBUG=false

# API Settings
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/meal_planner

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Configuration
DEFAULT_CALORIE_TARGET=2000
MEAL_VARIETY_THRESHOLD=0.7
NUTRITION_TOLERANCE_PERCENT=0.1
