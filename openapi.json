alysis_summary"],"title":"UserProfileAnalysisResponse","description":"Complete user profile analysis response"},"UserProfileRequest":{"properties":{"user_id":{"type":"string","title":"User Id","description":"User ID from backend"},"age":{"type":"integer","maximum":120.0,"minimum":1.0,"title":"Age","description":"User age in years"},"gender":{"type":"string","title":"Gender","description":"Gender: male, female, or other"},"height_cm":{"type":"number","exclusiveMinimum":0.0,"title":"Height Cm","description":"Height in centimeters"},"weight_kg":{"type":"number","exclusiveMinimum":0.0,"title":"Weight Kg","description":"Current weight in kilograms"},"goal_weight_kg":{"type":"number","exclusiveMinimum":0.0,"title":"Goal Weight Kg","description":"Target/goal weight in kilograms"},"health_goals":{"type":"string","title":"Health Goals","description":"Primary health goal (e.g., weight_loss, muscle_gain, maintenance)"},"activity_level":{"type":"string","title":"Activity Level","description":"Activity level: sedentary, light, moderate, active, very_active"}},"type":"object","required":["user_id","age","gender","height_cm","weight_kg","goal_weight_kg","health_goals","activity_level"],"title":"UserProfileRequest","description":"Request schema for user profile analysis"},"ValidationError":{"properties":{"loc":{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array","title":"Location"},"msg":{"type":"string","title":"Message"},"type":{"type":"string","title":"Error Type"},"input":{"title":"Input"},"ctx":{"type":"object","title":"Context"}},"type":"object","required":["loc","msg","type"],"title":"ValidationError"}}}}